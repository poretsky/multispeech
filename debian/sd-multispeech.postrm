#!/bin/sh

set -e

case "$1" in
    remove|purge)
        if [ -d /run/systemd/system/ ]; then
            deb-systemd-invoke reload speech-dispatcher || true
            deb-systemd-invoke --user reload speech-dispatcher || true
        else
            invoke-rc.d speech-dispatcher reload >/dev/null || true
        fi
        ;;

    upgrade|disappear|failed-upgrade|abort-install|abort-upgrade)

        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac


# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#


exit 0
